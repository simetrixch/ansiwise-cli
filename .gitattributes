# The binary compiled from this tree runs on Linux, and this repository is also
# edited on Windows. Enforce LF so what it reads there reads the way it reads here.
# The line-endings check is what proves the WORKING COPY kept to it, which is what
# git alone cannot see.

# Normalize all text to LF in the repo AND on checkout, on every platform.
* text=auto eol=lf

# Files that MUST be LF, whatever git makes of their content.
*.dart    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.tpl     text eol=lf
*.json    text eol=lf
*.conf    text eol=lf
*.config  text eol=lf
*.example text eol=lf

# Binary artifacts — never touch line endings.
*.tgz   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
