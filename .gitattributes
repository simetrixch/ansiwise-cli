# The binary compiled from this tree runs on Linux, and this repository is also
# edited on Windows. Enforce LF so what it reads there reads the way it reads here.
# The line-endings check is what proves the WORKING COPY kept to it, which is what
# git alone cannot see.

# Normalize all text to LF in the repo AND on checkout, on every platform.
* text=auto eol=lf

# Files that MUST be LF, whatever git makes of their content.
*.dart    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.tpl     text eol=lf
*.json    text eol=lf
*.conf    text eol=lf
*.config  text eol=lf
*.example text eol=lf
*.sh      text eol=lf
# The push hook is named after the moment git calls it, so it carries no extension of its own. A
# hook checked out with CRLF fails at its shebang with "bad interpreter: /bin/bash^M", and the
# shebang is the first thing that runs, so that failure names the interpreter rather than the file.
.githooks/* text eol=lf

# Binary artifacts — never touch line endings.
*.tgz   binary
*.gz    binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
