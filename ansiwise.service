[Unit]
Description=ansiwise deployment surface
# WHAT THIS FILE IS. The unit the binary compiled from this repository installs
# itself under, and the reason it lives beside that binary rather than beside an
# installation's programs: its ExecStart is composed of this binary's own options,
# and a unit kept anywhere else drifts from them with nothing reporting it. Its
# BASE NAME is the name the service manager knows the service by, so the file, the
# unit and the name a `systemctl` line mentions are one value.
#
# The two slots below are filled by lib/service_installation.dart with the whole
# started command and the directory it starts in. Nothing else in this file is
# per-installation, and a slot named here in a comment would be filled too.
#
# The service manager reads a unit only from its own directory. This copy is the
# source; the one it reads is written to /etc/systemd/system by the installer.
#
# Every run this service starts reaches a network — a catalogue to clone, a chart
# to pull, an image registry to read. network-online.target is what the service
# manager offers for "an address can be bound and a name can be resolved";
# network.target is up well before that is true.
After=network-online.target
Wants=network-online.target

[Service]
# WHERE THIS LISTENS STANDS IN THE COMMAND, AND IT IS THE MACHINE'S TAILNET ADDRESS.
#
# The caller is the manager, and it speaks plain HTTP and presents the service token
# in an Authorization header. So the address decides whether that credential crosses
# a wire somebody else can read: the tailnet carries it inside WireGuard between two
# members and nowhere else, while a public port puts the same header on the open
# internet with one bearer token in front of it.
#
# The node-local address was the other candidate and it reaches nobody that has to
# reach this. The manager runs as a workload in the cluster, where 127.0.0.1 is its
# own pod and not this machine — so a node-local bind would be reachable only
# through an SSH tunnel, which is the held-open session this resident service exists
# to stop needing. What node-local WOULD serve is somebody standing on the machine,
# and they have `ansiwise serve` over their own session for that.
#
# lib/service_installation.dart refuses every address outside the tailnet range, so
# the paragraph above is a rule and not a preference.
ExecStart=<command>
WorkingDirectory=<working-directory>
# It comes back when it dies, and it keeps coming back while the tailnet address it
# binds is not there yet — the state a machine is in for the first seconds after a
# restart, where the bind fails and this is the only thing that tries again.
Restart=always
RestartSec=5
# THE LINE THIS SERVICE EXISTS AROUND. Every run is started DETACHED so it outlives
# the surface that accepted it. The default kill mode takes the unit's whole control
# group with every stop, a restart is a stop, and a detached process gets a new
# session rather than a new control group — so without this line a 45-minute
# deployment dies with the restart of the service that launched it, and nothing on
# the machine says why.
KillMode=process

[Install]
# What makes it start on boot: the target the service manager reaches on its way up
# pulls this unit in.
WantedBy=multi-user.target
